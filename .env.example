# ==============================================================================
# RecoverIQ — Environment Configuration Template
# Copy this file to .env and provide your secret keys before starting the server.
# ==============================================================================

# Environment Mode: development / production / testing
ENV=development

# Database Connection URL (Defaults to local SQLite)
DATABASE_URL=sqlite:///./recoveriq.db

# API Key Authentication (Comma-separated list of authorized keys)
# Generate random 32+ character keys in production!
RECOVERIQ_OPERATOR_KEYS=rzp_operator_key_example,your_operator_key_here
RECOVERIQ_ADMIN_KEYS=rzp_admin_secret_example,your_admin_secret_here

# LLM Provider Configuration (Optional: Gemini 2.5 Flash for Natural Language Explanations)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# Razorpay Webhook Ingestion Secret (HMAC-SHA256 signature verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

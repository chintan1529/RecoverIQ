{
  "name": "recoveriq-root",
  "version": "1.0.0",
  "private": true,
  "description": "RecoverIQ — AI Revenue Recovery Decision Engine",
  "scripts": {
    "dev:backend": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir backend --app-dir backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "test": "pytest backend/tests/ -v",
    "build": "npm run build --prefix frontend"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
